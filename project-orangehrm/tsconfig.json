{
  "compilerOptions": {
    "rootDir": "./",
    "outDir": "dist",
    "module": "CommonJS",
    "target": "ESNext",
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@framework": [
        "../framework/src/index.ts"
      ], // 👈 root index
      "@framework/*": [
        "../framework/src/*"
      ], // optional for subpaths
      "@project/*": [
        "./*"
      ]
    }
  },
  "include": [
    "tests/**/*.ts",
    "auth/**/*.ts",
    "config/**/*.json",
    "utils/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ],
  "references": [
    {
      "path": "../framework"
    }
  ]
}