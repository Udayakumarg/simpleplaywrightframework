{
  "compilerOptions": {
    "rootDir": "./",
    "outDir": "dist",
    "module": "CommonJS",
    "target": "ESNext",
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "simple-playwright-framework": ["../framework/src/index.ts"],
      "@project/fixtures": ["./fixtures.ts"],
      "@project/auth": ["./auth/index.ts"],
      "@project/pages": ["./pages/index.ts"],
      "@project/*": ["./*"]
    }
  },
  "include": [
    "tests/**/*.ts",
    "auth/**/*.ts",
    "pages/**/*.ts",
    "config/**/*.json",
    "utils/**/*.ts",
    "playwright.config.ts"
  ],
  "exclude": ["node_modules", "dist"],
  "references": [{ "path": "../framework" }]
}
