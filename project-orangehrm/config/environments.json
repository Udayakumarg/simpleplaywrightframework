{
  "defaults": {
    "timeout": 30000,
    "retries": 1,
    "workers": 2,
    "headless": false
  },
  "dev": {
    "baseUrl": "${DEV_BASE_URL}",
    "apiUrl":  "${DEV_API_URL}",
    "authStorage": { "enabled": true, "validityMinutes": 30, "provider": "OrangeHRMLogin" }
  },
  "qa": {
    "baseUrl": "${QA_BASE_URL}",
    "apiUrl":  "${QA_API_URL}",
    "authStorage": { "enabled": true, "validityMinutes": 30, "provider": "OrangeHRMLogin" }
  },
  "prod": {
    "baseUrl": "${PROD_BASE_URL}",
    "apiUrl":  "${PROD_API_URL}",
    "authStorage": { "enabled": true, "validityMinutes": 30, "provider": "OrangeHRMLogin" }
  }
}
