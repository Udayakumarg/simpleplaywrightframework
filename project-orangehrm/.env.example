# Copy to `.env` and fill in real values. `.env` is gitignored.
# `.env.<TEST_ENV>` (e.g. `.env.qa`) is also loaded after `.env`.

# Pick which environment block to read from environments.json
TEST_ENV=prod

# Optional: tag filter for scenarioLoader
# SCENARIO_TAG=smoke

# Optional: which browser to run (chromium | firefox | webkit)
# BROWSER=chromium

# ── Per-environment URLs (referenced via ${VAR} in config/environments.json) ──
DEV_BASE_URL=https://dev.orangehrm.example.com
DEV_API_URL=https://dev.orangehrm.example.com/api

QA_BASE_URL=https://qa.orangehrm.example.com
QA_API_URL=https://qa.orangehrm.example.com/api

PROD_BASE_URL=https://opensource-demo.orangehrmlive.com/
PROD_API_URL=https://opensource-demo.orangehrmlive.com/api

# ── Credentials (referenced via ${VAR} in data/login/*.json) ──
ADMIN_USERNAME=Admin
ADMIN_PASSWORD=admin123

EMPLOYEE_USERNAME=Employee
EMPLOYEE_PASSWORD=employee123

# ── TestRail (optional) ──
# TESTRAIL_URL=https://yourcompany.testrail.io
# TESTRAIL_USER=ci@yourcompany.com
# TESTRAIL_APIKEY=
